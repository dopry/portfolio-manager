{
  "name": "portfolio-manager",
  "version": "0.0.0-semantic-release",
  "description": "Unofficial CLI Tool and SDK for Energy Star Portfolio Manager",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/"
  ],
  "bin": {
    "portfolio-manager": "dist/cli.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live-env": "vitest run --config vitest.live-env.config.ts",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:live-env": "tsc --noEmit -p tsconfig.live-env.json",
    "wipe:test-environment": "tsx ./scripts/wipeTestEnvironment.ts",
    "generate:xml": "tsx ./scripts/generateXmlTypes.ts",
    "generate:metrics": "tsx ./scripts/generateMetrics.ts",
    "semantic-release": "semantic-release",
    "src-bin": "tsx ./src/cli.ts",
    "build-bin": "node ./dist/cli.js"
  },
  "author": {
    "name": "Darrel O'Pry"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopry/portfolio-manager.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "semantic-release": "^25.0.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.4.2"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      {
        "name": "next",
        "prerelease": true
      }
    ]
  }
}
